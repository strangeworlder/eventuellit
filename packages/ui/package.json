{
    "name": "@repo/ui",
    "version": "0.1.0",
    "private": true,
    "exports": {
        ".": "./src/index.ts",
        "./components/utils": "./src/components/utils.ts",
        "./components/hyphenation": "./src/components/hyphenation.ts",
        "./components/attribute-dice": "./src/components/attribute-dice.ts",
        "./components/article-navigation-utils": "./src/components/article-navigation-utils.tsx",
        "./components/article-progress-events": "./src/components/article-progress-events.tsx",
        "./components/useFocusTrap": "./src/components/useFocusTrap.ts",
        "./components/useObscuredGlitch": "./src/components/useObscuredGlitch.ts",
        "./components/usePillIndicator": "./src/components/usePillIndicator.ts",
        "./components/*": [
            "./src/components/*.tsx",
            "./src/components/*.ts"
        ],
        "./*": [
            "./src/*.tsx",
            "./src/*.ts"
        ]
    },
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "lint": "biome check .",
        "generate:component": "turbo gen react-component",
        "build": "node scripts/build-icons.mjs",
        "prepare": "node scripts/build-icons.mjs",
        "check-types": "node scripts/build-icons.mjs && tsc --noEmit",
        "build:icons": "node scripts/build-icons.mjs",
        "storybook": "node scripts/build-icons.mjs && storybook dev -p 6006",
        "build-storybook": "node scripts/build-icons.mjs && storybook build"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/typescript-config": "*",
        "@storybook/addon-docs": "^10.2.13",
        "@storybook/addon-mcp": "^0.4.2",
        "@storybook/react": "^10.2.13",
        "@storybook/react-vite": "^10.2.13",
        "@tailwindcss/postcss": "^4.2.1",
        "@types/node": "^22.15.3",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "autoprefixer": "^10.4.27",
        "eslint": "^9.39.1",
        "eslint-plugin-storybook": "10.2.13",
        "jsdom": "^28.1.0",
        "jsdom-global": "^3.0.2",
        "postcss": "^8.5.6",
        "storybook": "^10.2.13",
        "svg-path-bbox": "^2.1.0",
        "tailwindcss": "^4.2.1",
        "typescript": "5.9.2"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "hyphenopoly": "^6.1.0",
        "lucide-react": "^0.576.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.13.1",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.5.0"
    }
}
