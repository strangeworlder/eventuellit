# Server Configuration
PORT=3000
DATABASE_URL=postgresql://root:password123@localhost:5432/eventuellit
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
JWT_SECRET=dev-secret-change-in-production
MAGIC_LINK_BASE_URL=http://localhost:3003

# Resend Email (required in production for magic link emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Host App Configuration
# Replace these with the production URLs of your micro-frontends
VITE_GENERATOR_URL=http://localhost:3001
VITE_RULESET_URL=http://localhost:3002
VITE_EPISODES_URL=http://localhost:3004
VITE_WORLD_URL=http://localhost:3005

# Cloudflare R2 Media Storage (required in production for image uploads)
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=eventuellit-media
R2_PUBLIC_URL=https://media.eventuell.it

# Generator App Configuration
# Replace with the production URL of your NestJS backend
VITE_API_BASE_URL=http://localhost:3000
